# --- 忽略 Python 的暫存垃圾 ---
__pycache__/
*.pyc

# --- 忽略環境變數 (這是你的金鑰保險箱) ---
.env

# --- 忽略資料庫檔案 (如果之後有的話) ---
*.sqlite3
*.db

# --- 忽略作業系統產生的垃圾 ---
.DS_Store
Thumbs.db

# --- 忽略虛擬環境 ---
venv/

# --- 忽略.at檔 ---
*.bat

# --- 忽略.csv ---
*.csv

# --- 忽略.xls ---
*.xls

node_modules/
package-lock.json
# 如果 predict 下的這些 json 是動態產生的產物，也建議排除
predict/*_tomorrow.json
predict/*_next_week.json